
{
  "info": {
    "name": "Backend Demo API Testing",
    "description": "Postman collection for testing user registration, login, logout and post CRUD operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "username", "value": "" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "Test@4567" },
    { "key": "postId", "value": "" },
    { "key": "missingPostId", "value": "000000000000000000000000" }
  ],
  "item": [
    {
      "name": "Check Server",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/posts/getPosts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Server responds successfully', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
