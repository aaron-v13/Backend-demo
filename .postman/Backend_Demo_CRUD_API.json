    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Post created successfully', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "const data = pm.response.json();",
                  "function getPostId(obj) {",
                  "    if (!obj || typeof obj !== 'object') return null;",
                  "    if (obj._id) return obj._id;",
                  "    for (const key in obj) {",
                  "        const found = getPostId(obj[key]);",
                  "        if (found) return found;",
                  "    }",
                  "    return null;",
                  "}",
                  "const id = getPostId(data);",
                  "if (id) pm.collectionVariables.set('postId', id);",
                  "pm.test('Post ID saved', function () {",
                  "    pm.expect(id).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Backend Development Project\",\n  \"description\": \"Testing the post creation API using Postman\",\n  \"age\": 28\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/posts/create"
          }
        },
        {
          "name": "Create Post Invalid Age",
          "event": [
            {
              "listen": "test",
              "script": {
